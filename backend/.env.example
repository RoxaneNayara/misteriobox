# Porta HTTP da API
PORT=3333

# Segredo usado para assinar os tokens JWT. Gere um valor aleatório e longo, por exemplo:
#   openssl rand -hex 32
# Se ficar vazio, a API gera um segredo temporário a cada inicialização.
JWT_SECRET=

# Expiração absoluta da sessão, em segundos, contada a partir do login (28800 = 8 horas)
JWT_EXPIRES_IN_SECONDS=28800

# Expiração por inatividade, em segundos (1800 = 30 minutos). Cada renovação
# (POST /api/auth/refresh) estende a sessão até este limite, sem passar das 8 horas.
SESSION_IDLE_TIMEOUT_SECONDS=1800

# Origem do frontend autorizada pelo CORS
CORS_ORIGIN=http://localhost:5173

# Custo do hash bcrypt das senhas
BCRYPT_SALT_ROUNDS=10

# Senhas dos três usuários demonstrativos (uso exclusivamente local).
# Defina valores próprios com pelo menos 8 caracteres, letras e números.
# Se ficarem vazias, a API gera senhas temporárias a cada inicialização e as
# exibe no console do backend.
DEMO_USER_SOFIA_PASSWORD=
DEMO_USER_BRUNO_PASSWORD=
DEMO_USER_LIVIA_PASSWORD=
