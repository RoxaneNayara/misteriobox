# Porta HTTP da API (somente execução local; na Vercel não é usada)
PORT=3333

# Banco de dados persistente (MongoDB Atlas ou compatível).
# Vazio: a API usa um MongoDB em memória (só desenvolvimento local e testes; os dados somem ao
# reiniciar). Production e Preview na Vercel usam MongoDB Atlas persistente (obrigatório).
# Obrigatória em produção e em qualquer implantação na Vercel. Formato:
#   mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Nunca grave a URI real neste arquivo nem no repositório.
MONGODB_URI=

# Nome do banco dentro do cluster (padrão: misteriobox)
MONGODB_DB_NAME=misteriobox

# Segredo usado para assinar os tokens JWT. Gere um valor aleatório e longo, por exemplo:
#   openssl rand -hex 32
# Localmente, se ficar vazio, a API gera um segredo temporário a cada inicialização.
# Em produção é obrigatório, com pelo menos 32 caracteres.
JWT_SECRET=

# Expiração absoluta da sessão, em segundos, contada a partir do login (28800 = 8 horas)
JWT_EXPIRES_IN_SECONDS=28800

# Expiração por inatividade, em segundos (1800 = 30 minutos). Cada renovação
# (POST /api/auth/refresh) estende a sessão até este limite, sem passar das 8 horas.
SESSION_IDLE_TIMEOUT_SECONDS=1800

# Origens do frontend autorizadas pelo CORS (separe várias por vírgula).
# Na Vercel, frontend e API ficam no mesmo domínio e o CORS não é necessário.
CORS_ORIGIN=http://localhost:5173

# Custo do hash bcrypt das senhas
BCRYPT_SALT_ROUNDS=10

# Usuários demonstrativos (somente local). Padrão: true. Em produção são sempre
# desativados e SEED_DEMO_USERS=true interrompe a inicialização.
SEED_DEMO_USERS=true

# Senhas dos três usuários demonstrativos (uso exclusivamente local).
# Defina valores próprios com pelo menos 8 caracteres, letras e números.
# Se uma variável ficar vazia, o usuário correspondente não é criado (nenhuma
# senha é gerada nem exibida no terminal ou em logs).
DEMO_USER_SOFIA_PASSWORD=
DEMO_USER_BRUNO_PASSWORD=
DEMO_USER_LIVIA_PASSWORD=
